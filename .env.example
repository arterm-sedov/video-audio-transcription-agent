# Provider credentials — set these as local secrets or Hugging Face Space Secrets.
# Never commit a real key.
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
# Rubles per USD, used when Polza reports usage.cost_rub.
POLZA_RUB_TO_USD_RATE=85

GEMINI_KEY=
# GEMINI_API_KEY is also accepted by the direct Gemini adapter.
# GEMINI_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Providers are tried from left to right when a call fails. The first entry is
# the default provider for the CLI and GUI.
TRANSCRIPTION_PROVIDER_ORDER=polza,openrouter,gemini
# google/... is the Polza/OpenRouter model identifier.
# Direct Gemini automatically removes the google/ prefix.
TRANSCRIPTION_MODEL=google/gemini-3.1-flash-lite
# CLI override: uv run transcription-agent transcribe media.mp4 --model google/gemini-3.1-flash-lite

# Long media is split into temporary chunks before provider submission.
# 0 (default) = auto: chunk size derives from the model's context window and
# worst-case token-per-second rate; positive = fixed seconds (min 300).
TRANSCRIPTION_CHUNK_SECONDS=0
# All generated files and the SQLite job registry use this directory.
TRANSCRIPTION_OUTPUT_DIR=.transcriptions
TRANSCRIPTION_DATABASE=.transcriptions/jobs.sqlite3

# Enables the voice-diarization signal when a diarization backend is configured.
# Visual active-speaker cues remain the primary video signal.
TRANSCRIPTION_DIARIZATION=true
# Maximum response tokens per provider call.
TRANSCRIPTION_MAX_OUTPUT_TOKENS=8192
# Seconds to wait for a hosted upload before falling back to inline base64.
TRANSCRIPTION_UPLOAD_TIMEOUT=30
# Per-provider proxies are the primary mechanism. When TRANSCRIPTION_<PROVIDER>_PROXY
# is present in the environment (even as an empty string), that value is used and
# does not inherit TRANSCRIPTION_PROXY. Only a missing key falls back to the global
# proxy. Leave TRANSCRIPTION_OPENROUTER_PROXY empty to keep OpenRouter direct.
# Polza on this network uses the RU route SOCKS5 proxy; OpenRouter and Gemini
# use native/VPN routes. Example: socks5h://<proxy-host>:<port>
TRANSCRIPTION_POLZA_PROXY=socks5h://<proxy-host>:<port>
TRANSCRIPTION_OPENROUTER_PROXY=
TRANSCRIPTION_GEMINI_PROXY=
# Optional global fallback when a per-provider value is unset.
TRANSCRIPTION_PROXY=
